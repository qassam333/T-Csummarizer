{
    
    "name": "T&C summarizer",
    "description": "summarize the terms and conditions of a website",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "icons/icon.png",
        "48": "icons/icon.png",
        "128": "icons/icon.png"
    },
    "permissions" : [
        "activeTab", 
        "scripting", 
        "storage" 
    ],
    "host_permissions" :[
        "http://localhost:8000/*"
    ],
    "content_scripts" :[
     {
        "matches": ["<all_urls>"],
        "js": ["content.js"]

    
     }
    ]
}